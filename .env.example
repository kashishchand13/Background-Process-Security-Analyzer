# Copy these values into your Windows environment before running the app.
# Oracle XE default pluggable database service is commonly XEPDB1.
# Use a dedicated project schema user, not SYSTEM or SYS.
BSA_DB_HOST=127.0.0.1
BSA_DB_PORT=1521
BSA_DB_SERVICE_NAME=XEPDB1
BSA_DB_USER=BSA
BSA_DB_PASSWORD=
BSA_SCAN_INTERVAL=5
BSA_METRICS_INTERVAL=30
BSA_METRICS_TOP_N=25
BSA_CPU_ALERT_THRESHOLD=85
BSA_MEMORY_ALERT_THRESHOLD=35
BSA_MAX_HASH_FILE_MB=100
